# HTTP port
PORT=4000

# PostgreSQL connection string. Leave empty to use the embedded PGlite
# database stored in ./data/pglite (zero-setup local dev).
DATABASE_URL=postgres://octolearn:octolearn@localhost:5432/octolearn

# Change this in any non-local environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Encrypts secrets saved from the admin "Тохиргоо" page (e.g. the Bunny API key).
# Defaults to JWT_SECRET. Changing it makes stored secrets unreadable — re-enter them.
# SETTINGS_SECRET=another-long-random-string

# Comma-separated list of allowed origins for CORS ("*" = any).
CORS_ORIGIN=*

# Timezone used to bucket activity into days (streak, weekly chart).
APP_TIMEZONE=Asia/Ulaanbaatar
