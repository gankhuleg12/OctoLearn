# Backend URL. Leave unset in development: the app then uses the Metro host's
# LAN IP on port 4000 (so a phone on the same Wi-Fi reaches your computer),
# 10.0.2.2:4000 on the Android emulator, or localhost:4000 on web.
# Required for standalone builds (APK / TestFlight), e.g. a hosted backend:
# EXPO_PUBLIC_API_URL=https://api.octolearn.example.com
